# Copy this file to .env and edit. Never commit your real .env to GitHub.

EXCHANGE_ID=htx
SYMBOL=BTC/USDT
# SYMBOLS is what `run`/`live` actually trade — comma-separated, shares one
# equity pool and one risk budget (MAX_EXPOSURE_PCT applies across all of
# them combined). Defaults to just SYMBOL if left blank. More symbols means
# more AI/news calls per cycle — watch free-tier rate limits.
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAMES=15m,1h,4h

STARTING_CAPITAL=1000
RISK_PER_TRADE_PCT=0.5
MAX_EXPOSURE_PCT=30
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=15
ATR_STOP_MULT=2.0
ATR_TAKE_MULT=3.5

POLL_SECONDS=60

# --- Live trading is OFF by default. Both flags below must be true, plus
# --- real API keys, to unlock the `live` command — and it still asks for a
# --- typed confirmation before doing anything.
LIVE_TRADING=false
I_UNDERSTAND_THE_RISK=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Multi-AI expert panel (all optional — leave blank to skip a provider) ---
# Each key you fill in adds one more "expert" vote alongside the 15m/1h/4h
# technical experts; the auto-learning brain learns how much to trust it
# over time, same as everything else. None of them can execute a trade or
# touch the risk engine's limits. Rate limits and free-tier availability
# change over time — check each provider's own site if a call starts failing.

# Free, no credit card: console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free, no credit card: openrouter.ai/keys ("openrouter/free" auto-picks a free model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Free, no credit card: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional paid extras — off unless keyed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Which provider synthesizes the individual AI verdicts into one final call
# (LLM-as-judge). Blank = auto-pick whichever configured provider answers.
AI_JUDGE_PROVIDER=

# Lets Anthropic/Groq/OpenRouter/OpenAI call a real get_price_series tool
# themselves before answering (bounded to a couple of rounds). Off saves
# tokens/latency/rate-limit budget at the cost of less context per verdict.
AI_TOOL_USE_ENABLED=true

DB_PATH=zora.db

# --- Logging: console + rotating file (see logging_setup.py). LOG_LEVEL
# --- INFO (default) shows every cycle's price/signal plus opens/closes/
# --- kill-switch/errors; WARNING quiets it down to just problems.
LOG_LEVEL=INFO
LOG_FILE=zora.log

# --- Telegram alerts + remote control (both optional — see telegram_control.py
# --- for setup steps via @BotFather). Leave blank to disable entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
